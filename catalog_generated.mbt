///|
pub(all) enum CatalogTone {
  ToneCanvas
  ToneSurface
  ToneDivider
  ToneAccent
  ToneBodyText
  ToneStrongText
} derive(Eq, Debug)

///|
pub(all) struct CatalogSwatch {
  id : String
  family : String
  step : Int
  color : Color
  role : Role
  tone : CatalogTone
  recommended_foreground : Color
  target_background : Color
  note : String
} derive(Eq, Debug)

///|
pub(all) struct CatalogFamilySummary {
  family : String
  total : Int
  foregrounds : Int
  backgrounds : Int
  average_luminance : Double
  minimum_recommended_contrast : Double
} derive(Eq, Debug)

///|
pub fn CatalogTone::label(self : CatalogTone) -> String {
  match self {
    ToneCanvas => "canvas"
    ToneSurface => "surface"
    ToneDivider => "divider"
    ToneAccent => "accent"
    ToneBodyText => "body-text"
    ToneStrongText => "strong-text"
  }
}

///|
pub fn CatalogSwatch::as_swatch(self : CatalogSwatch) -> Swatch {
  swatch(self.id, self.color, self.role)
}

///|
pub fn CatalogSwatch::recommended_audit(
  self : CatalogSwatch,
  policy : Policy,
) -> PairAudit {
  audit_pair(
    swatch(self.id + ".recommended", self.recommended_foreground, RoleText),
    swatch(
      self.id,
      self.color,
      if self.role.is_background() {
        self.role
      } else {
        RoleBackground
      },
    ),
    policy,
  )
}

///|
pub fn built_in_catalog() -> Array[CatalogSwatch] {
  let out : Array[CatalogSwatch] = []
  for item in catalog_aurora() {
    out.push(item)
  }
  for item in catalog_basalt() {
    out.push(item)
