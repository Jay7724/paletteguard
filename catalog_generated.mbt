///|
pub fn catalog_families() -> Array[String] {
  [
    "aurora", "basalt", "coral", "dune", "ember", "fern", "glacier", "harbor", "indigo",
    "jasmine", "kelp", "lagoon", "mango", "nebula", "obsidian", "plum", "quartz",
    "rose", "spruce", "tide", "umber", "violet", "willow", "xenon", "yarrow", "zenith",
  ]
}

///|
pub fn catalog_by_family(family : String) -> Array[CatalogSwatch] {
  let out : Array[CatalogSwatch] = []
  for item in built_in_catalog() {
    if item.family == family {
      out.push(item)
    }
  }
  out
}

///|
pub fn catalog_by_role(role : Role) -> Array[CatalogSwatch] {
  let out : Array[CatalogSwatch] = []
  for item in built_in_catalog() {
    if item.role == role {
      out.push(item)
    }
  }
  out
}

///|
pub fn catalog_find(id : String) -> CatalogSwatch? {
  for item in built_in_catalog() {
    if item.id == id {
      return Some(item)
    }
  }
  None
}

///|
pub fn catalog_as_swatches(items : Array[CatalogSwatch]) -> Array[Swatch] {
  [
    for item in items => item.as_swatch()
  ]
}

///|
pub fn catalog_palette_for_family(family : String) -> Array[Swatch] {
  catalog_as_swatches(catalog_by_family(family))
}

///|
pub fn catalog_audit_family(family : String, policy : Policy) -> PaletteReport {
  audit_palette(catalog_palette_for_family(family), policy)
}

///|
pub fn catalog_summary(family : String) -> CatalogFamilySummary {
  let items = catalog_by_family(family)
  let mut foregrounds = 0
  let mut backgrounds = 0
  let mut sum = 0.0
  let mut minimum = 99.0
  for item in items {
    if item.role.is_foreground() {
      foregrounds += 1
    }
    if item.role.is_background() {
      backgrounds += 1
    }
    sum += item.color.relative_luminance()
    minimum = min_double(
      minimum,
      contrast_ratio(item.recommended_foreground, item.color),
    )
  }
  let average = if items.length() == 0 {
    0.0
  } else {
    sum / items.length().to_double()
  }
  let min_ratio = if items.length() == 0 { 0.0 } else { minimum }
  {
    family,
    total: items.length(),
    foregrounds,
    backgrounds,
    average_luminance: average,
    minimum_recommended_contrast: min_ratio,
  }
}

///|
pub fn catalog_markdown() -> String {
  let out = StringBuilder()
  out.write_string("# PaletteGuard built-in catalog\n\n")
  out.write_string(
    "Families: " + catalog_families().length().to_string() + "\n",
  )
  out.write_string(
    "Swatches: " + built_in_catalog().length().to_string() + "\n\n",
  )
  out.write_string("| id | role | tone | color | recommended |\n")
  out.write_string("| --- | --- | --- | --- | --- |\n")
  for item in built_in_catalog() {
    out.write_string("| " + item.id + " | ")
    out.write_string(item.role.label() + " | ")
    out.write_string(item.tone.label() + " | ")
    out.write_string(item.color.to_hex() + " | ")
    out.write_string(item.recommended_foreground.to_hex() + " |\n")
  }
  out.to_string()
}

